doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Stars
        a.table-link(href="/update-cobj") Add to this table
        table
            thead
                tr
                    th Name
                    th Constellation
                    th Bio
            tbody
                each star in data
                    tr
                        td #{star.properties.name}
                        td #{star.properties.constellation}
                        td #{star.properties.bio}
