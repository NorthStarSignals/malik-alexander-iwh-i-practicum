doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Add a new star
        .form-wrapper
            form(method="POST" action="/update-cobj")
                label(for="name") Name
                input(type="text" id="name" name="name" required)
                label(for="constellation") Constellation
                input(type="text" id="constellation" name="constellation" required)
                label(for="bio") Bio
                input(type="text" id="bio" name="bio" required)
                input(type="submit" value="Save star")
            a.table-link(href="/") Return to the homepage
